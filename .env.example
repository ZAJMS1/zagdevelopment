# SMTP server used to send contact-form emails (Gmail by default).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# SMTP credentials. For Gmail, use a 16-character App Password.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password

# "From" header on outgoing emails (usually same as MAIL_USERNAME).
MAIL_DEFAULT_SENDER=you@gmail.com

# Optional override: where contact form submissions should be delivered.
# Defaults to MAIL_DEFAULT_SENDER if unset.
# CONTACT_TO=team@zagdevelopment.com
