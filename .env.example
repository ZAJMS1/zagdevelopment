# SMTP server used to send contact-form emails (Gmail by default).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# SMTP credentials. For Gmail, use a 16-character App Password.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password

# SMTP login is the Gmail account. "From" can be a verified send-as alias.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=andrew@zagdevelopment.com

# Where contact form submissions should be delivered.
CONTACT_TO=you@gmail.com

# Stripe (deposit checkout on /pricing). Dashboard -> Developers -> API keys.
# Use sk_test_... locally; the live sk_live_... key goes in Vercel only.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for /api/stripe/webhook (emails CONTACT_TO when a deposit is paid).
# Locally: printed by `stripe listen`. Production: from the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
